@startuml
left to right direction
skinparam packageStyle rectangle

actor "Administrateur" as Admin
actor "Gestionnaire du patrimoine" as Gest
actor "Agent de service" as Agent
actor "Auditeur" as Aud

rectangle "Gestion du patrimoine de l'État" {
  usecase "S'authentifier" as UC1
  usecase "Gérer les utilisateurs et les rôles" as UC2
  usecase "Gérer les catégories" as UC3
  usecase "Gérer les biens (CRUD)" as UC4
  usecase "Rechercher / filtrer les biens" as UC5
  usecase "Affecter un bien à un service" as UC6
  usecase "Transférer un bien" as UC7
  usecase "Réformer / céder un bien" as UC8
  usecase "Consulter l'historique d'un bien" as UC9
  usecase "Signaler une panne" as UC10
  usecase "Consulter le tableau de bord" as UC11
  usecase "Exporter l'inventaire" as UC12
}

Admin --> UC2
Admin --> UC3
Gest --> UC4
Gest --> UC6
Gest --> UC7
Gest --> UC8
Gest --> UC11
Gest --> UC12
Agent --> UC5
Agent --> UC10
Aud --> UC9
Aud --> UC11
Aud --> UC12

UC2 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>
UC7 ..> UC1 : <<include>>
UC8 ..> UC1 : <<include>>
UC10 ..> UC1 : <<include>>
UC5 ..> UC4 : <<extend>>
@enduml
